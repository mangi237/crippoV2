  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public, anonymized Crippo user profiles."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Private PII, MoMo phone number, and KYC identity records."
    },
    "/entities/{entityId}": {
      "schema": { "$ref": "#/entities/Entity" },
      "description": "Creator, agency, and record label market entities."
    },
    "/races/{raceId}": {
      "schema": { "$ref": "#/entities/Race" },
      "description": "AI-underwritten creator project fundraising Races."
    },
    "/trades/{tradeId}": {
      "schema": { "$ref": "#/entities/Trade" },
      "description": "Executed anonymized order book trades and user positions."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/Payment" },
      "description": "User CamPay Mobile Money transaction ledger."
    },
    "/catalysts/{catalystId}": {
      "schema": { "$ref": "#/entities/Catalyst" },
      "description": "Unified social and cultural pulse catalyst feed."
    },
    "/predictions/{predictionId}": {
      "schema": { "$ref": "#/entities/Prediction" },
      "description": "Live YES/NO cultural prediction markets."
    },
    "/memos/{memoId}": {
      "schema": { "$ref": "#/entities/Memo" },
      "description": "Paid creator listing memo requests."
    },
    "/campaigns/{campaignId}": {
      "schema": { "$ref": "#/entities/Campaign" },
      "description": "Brand partnership campaigns with CamPay escrow."
    },
    "/dividend_payouts/{payoutId}": {
      "schema": { "$ref": "#/entities/DividendPayout" },
      "description": "Monthly royalty dividend clearing payouts."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "Real-time notifications and Raise approval offers."
    },
    "/affiliation_requests/{requestId}": {
      "schema": { "$ref": "#/entities/AffiliationRequest" },
      "description": "Label/agency roster affiliation requests to creators."
    }
  }
}
