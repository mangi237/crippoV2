{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public, anonymized exchange identity for a Crippo user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "anonymousId": { "type": "string", "maxLength": 32 },
        "displayName": { "type": "string", "maxLength": 80 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "walletBalanceXAF": { "type": "number" },
        "city": { "type": "string", "maxLength": 40 },
        "interests": { "type": "array" },
        "onboardingComplete": { "type": "boolean" },
        "creatorModeEnabled": { "type": "boolean" },
        "claimedEntityId": { "type": "string", "maxLength": 128 },
        "kycStatus": { "type": "string", "enum": ["none", "pending", "verified", "rejected"] },
        "affiliationType": { "type": "string", "enum": ["solo", "agency"] },
        "agencyName": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "anonymousId", "displayName", "city", "onboardingComplete", "creatorModeEnabled", "kycStatus", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Strictly isolated PII, Mobile Money, and KYC documents owned by a single user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 20, "pattern": "^2376[0-9]{8}$" },
        "momoProvider": { "type": "string", "enum": ["MTN", "ORANGE", "OTHER"] },
        "fullNameLegal": { "type": "string", "maxLength": 120 },
        "cniNumber": { "type": "string", "maxLength": 40 },
        "niuNumber": { "type": "string", "maxLength": 40 },
        "cniFrontUrl": { "type": "string", "maxLength": 500 },
        "cniBackUrl": { "type": "string", "maxLength": 500 },
        "selfieUrl": { "type": "string", "maxLength": 500 },
