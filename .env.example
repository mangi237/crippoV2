# GEMINI_API_KEY: Required for Gemini AI API calls (Underwriter & Cultural Pulse Agents).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CamPay Mobile Money API (MTN MoMo & Orange Money in Cameroon / XAF)
# Obtain from https://demo.campay.net (sandbox) or https://campay.net (production)
CAMPAY_ENV="demo"
CAMPAY_APP_USERNAME=""
CAMPAY_APP_PASSWORD=""
CAMPAY_WEBHOOK_KEY=""

# YouTube Data API v3 (Real Creator Channel & Video Velocity Metrics)
# Obtain from https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=""

# Spotify Web API (Real Artist Streams & Popularity Metrics)
# Obtain from https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Apify API Token (Unified Scraper for TikTok #237 & Public Facebook Entertainment Pages)
# Obtain from https://console.apify.com/account/integrations
APIFY_API_TOKEN=""
