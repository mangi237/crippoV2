# GEMINI_API_KEY: Required for Gemini AI API calls (Underwriter & Cultural Pulse Agents).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Fapshi Payment API (MTN MoMo, Orange Money & Bank Cards in Cameroon / XAF)
# In sandbox mode, Fapshi allows instant testing with sandbox numbers (e.g. 670000000 or 690000000)
FAPSHI_ENV="sandbox"
FAPSHI_API_USER="42b09d01-c518-4089-9d90-3773da5590bb"
FAPSHI_API_KEY="FAK_TEST_43281e161f130b790d46"
FAPSHI_WEBHOOK_SECRET=""

# Apify API Token (Unified Cross-Platform Scrapers: Spotify, TikTok, Instagram, Facebook, Google Search)
# Obtain from https://console.apify.com/account/integrations
APIFY_API_TOKEN=""

# Optional YouTube Data API v3 (Can also be covered by Apify Scrapers)
# Obtain from https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=""

# Optional Spotify Web API (App uses automation-lab/spotify-scraper via Apify when omitted)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
