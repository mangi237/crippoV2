# GEMINI_API_KEY: Required for Gemini AI API calls (Underwriter & Cultural Pulse Agents).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# CamPay Mobile Money API (MTN MoMo, Orange Money & Bank Cards in Cameroon / XAF)
# Obtain from https://demo.campay.net (sandbox) or https://campay.net (production)
CAMPAY_ENV="demo"
CAMPAY_APP_ID=""
CAMPAY_APP_USERNAME=""
CAMPAY_APP_PASSWORD=""
CAMPAY_PERMANENT_TOKEN=""
CAMPAY_WEBHOOK_KEY=""

# Apify API Token (Unified Cross-Platform Scrapers: Spotify, TikTok, Instagram, Facebook, Google Search)
# Obtain from https://console.apify.com/account/integrations
APIFY_API_TOKEN=""

# Optional YouTube Data API v3 (Can also be covered by Apify Scrapers)
# Obtain from https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=""

# Optional Spotify Web API (App uses automation-lab/spotify-scraper via Apify when omitted)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""
