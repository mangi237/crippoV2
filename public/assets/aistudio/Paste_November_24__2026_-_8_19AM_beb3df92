<script>
  let activeMode = 'SELL';
  const unitPrice = 6200;
  const maxAvailable = 8;

  function switchDesk(mode) {
    activeMode = mode;
    const buyBtn = document.getElementById('buy-tab');
    const sellBtn = document.getElementById('sell-tab');
    const actionBtn = document.getElementById('execute-btn');
    const actionText = document.getElementById('btn-text');

    if (mode === 'BUY') {
      buyBtn.className = 'py-2.5 rounded-lg font-headline-sm text-body-md transition-all bg-secondary text-on-secondary shadow-sm flex items-center justify-center gap-1.5';
      sellBtn.className = 'py-2.5 rounded-lg font-headline-sm text-body-md transition-all text-on-surface-variant flex items-center justify-center gap-1.5';
      actionBtn.className = 'w-full h-13 py-3.5 bg-on-tertiary-container hover:bg-tertiary text-on-tertiary rounded-xl font-headline-sm text-body-lg flex items-center justify-center gap-2 active:scale-[0.99] transition-transform shadow-md';
      actionText.innerText = 'Buy Shares via MTN CamPay';
    } else {
      sellBtn.className = 'py-2.5 rounded-lg font-headline-sm text-body-md transition-all bg-secondary text-on-secondary shadow-sm flex items-center justify-center gap-1.5';
      buyBtn.className = 'py-2.5 rounded-lg font-headline-sm text-body-md transition-all text-on-surface-variant flex items-center justify-center gap-1.5';
      actionBtn.className = 'w-full h-13 py-3.5 bg-primary hover:bg-primary-container text-on-primary rounded-xl font-headline-sm text-body-lg flex items-center justify-center gap-2 active:scale-[0.99] transition-transform shadow-md';
      const input = document.getElementById('share-input');
      actionText.innerText = `List ${input.value} Shares for Instant Resale`;
    }
  }

  function adjustShares(delta) {
    const input = document.getElementById('share-input');
    let val = parseInt(input.value) + delta;
    if (val < 1) val = 1;
    if (val > maxAvailable) val = maxAvailable;
    input.value = val;
    calculateSettlement(val);
  }

  function setSharePercent(pct) {
    const qty = Math.max(1, Math.round(maxAvailable * pct));
    const input = document.getElementById('share-input');
    input.value = qty;
    calculateSettlement(qty);
  }

  function calculateSettlement(shares) {
    const qty = parseInt(shares) || 1;
    const gross = qty * unitPrice;
    const fee = Math.round(gross * 0.03);
    const net = gross - fee;

    document.getElementById('gross-val').innerText = gross.toLocaleString('fr-FR') + ' FCFA';
    document.getElementById('fee-val').innerText = '-' + fee.toLocaleString('fr-FR') + ' FCFA';
    document.getElementById('net-val').innerText = net.toLocaleString('fr-FR') + ' FCFA';

    if (activeMode === 'SELL') {
      document.getElementById('btn-text').innerText = `List ${qty} Shares for Instant Resale`;
    }
  }

  function executeP2POrder() {
    const toast = document.getElementById('toast');
    toast.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
    toast.classList.add('opacity-100', 'translate-y-0');
    
    setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
    }, 3500);
  }
</script></main></body></html>

