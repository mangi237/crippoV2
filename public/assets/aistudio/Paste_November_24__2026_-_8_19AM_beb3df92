    if (btnPlus) {
      btnPlus.addEventListener('click', function() {
        if (currentShares < 200) {
          currentShares += 1;
          updateState();
        }
      });
    }

    presets.forEach(function(pill) {
      pill.addEventListener('click', function() {
        const qty = parseInt(pill.getAttribute('data-qty'), 10);
        if (!isNaN(qty)) {
          currentShares = qty;
          presets.forEach(function(p) {
            p.classList.remove('bg-secondary-fixed', 'text-on-secondary-fixed', 'font-bold');
