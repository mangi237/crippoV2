<script>
  function triggerAuthAction(message) {
    const alertBox = document.getElementById('authAlert');
    const alertText = document.getElementById('authAlertText');
    const userQuery = document.getElementById('userQuery').value;
    
    if (alertBox && alertText) {
      alertText.textContent = `[${userQuery}] → ${message}`;
      alertBox.classList.remove('hidden');
      alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }

  function handleApprove(button, projectName) {
    button.disabled = true;
    button.classList.remove('bg-on-tertiary-container');
    button.classList.add('bg-surface-container-high', 'text-on-surface-variant');
    button.innerHTML = `<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span> Minting Shares...`;
    
    setTimeout(() => {
      button.innerHTML = `<span class="material-symbols-outlined text-[18px] text-on-tertiary-container">check_circle</span> Minted & Listed`;
      const parentCard = button.closest('.rounded-xl');
      if (parentCard) {
        parentCard.classList.add('opacity-75');
      }
    }, 1200);
  }

  function handleCounter(button) {
    const counterAmount = prompt("Enter revised funding cap or split mandate for this creator (FCFA):", "10,000,000");
    if (counterAmount) {
      button.textContent = `Countered (${counterAmount} FCFA)`;
      button.classList.add('bg-secondary', 'text-on-secondary');
    }
  }
