<script>
  (function() {
    const budgetInput = document.getElementById('netBudgetInput');
    const revSlider = document.getElementById('revShareSlider');
    const revShareLabel = document.getElementById('revShareLabel');
    const feeDisplay = document.getElementById('crippoFeeDisplay');
    const totalRaiseDisplay = document.getElementById('totalRaiseDisplay');

    function formatFCFA(val) {
      return new Intl.NumberFormat('fr-FR').format(val) + ' FCFA';
    }

    function recalculate() {
      if (!budgetInput || !feeDisplay || !totalRaiseDisplay) return;
      const budget = parseFloat(budgetInput.value) || 0;
      const fee = budget * 0.05;
      const total = budget + fee;

      feeDisplay.textContent = formatFCFA(fee);
      totalRaiseDisplay.textContent = formatFCFA(total);
    }

    if (revSlider && revShareLabel) {
      revSlider.addEventListener('input', (e) => {
        revShareLabel.textContent = e.target.value + '% GROSS';
      });
    }

    if (budgetInput) {
      budgetInput.addEventListener('input', recalculate);
    }

    window.setBudget = function(val) {
      if (budgetInput) {
        budgetInput.value = val;
        recalculate();
      }
    };
  })();
</script></main></div></body></html>

