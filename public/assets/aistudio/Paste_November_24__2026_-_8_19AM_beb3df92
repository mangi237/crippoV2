<script>
  let currentStep = 1;
  let selectedEntity = 'solo';
  let activeCarrier = 'mtn';

  function updateWizardUI() {
    // Hide all step containers
    for (let i = 1; i <= 5; i++) {
      const container = document.getElementById(`stepContainer${i}`);
      if (container) {
        container.classList.add('hidden');
      }
    }
    
    // Show active step
    const activeContainer = document.getElementById(`stepContainer${currentStep}`);
    if (activeContainer) {
      activeContainer.classList.remove('hidden');
    }

    // Update Counter & Progress Bar
    document.getElementById('currentStepDisplay').innerText = currentStep;
    const progressPercents = [20, 40, 60, 80, 100];
    document.getElementById('completionRateText').innerText = `${progressPercents[currentStep - 1]}% Complete`;
    document.getElementById('stepProgressBar').style.width = `${progressPercents[currentStep - 1]}%`;

    // Update Sidebar Navigation state
    const navItems = document.querySelectorAll('.step-nav-item');
    navItems.forEach((item, index) => {
      const stepIdx = index + 1;
      const numBadge = item.querySelector('.step-num');
      const statusPill = item.querySelector('.status-pill');

      if (stepIdx < currentStep) {
        item.classList.remove('bg-surface-container', 'text-on-surface');
        item.classList.add('text-on-surface-variant');
        numBadge.className = 'step-num w-6 h-6 rounded-lg bg-tertiary-fixed text-on-tertiary-fixed flex items-center justify-center font-label-xs text-label-xs font-bold shrink-0 mt-0.5';
        numBadge.innerHTML = '<span class="material-symbols-outlined text-[14px]">check</span>';
        statusPill.className = 'status-pill font-label-xs text-label-xs text-on-tertiary-container bg-surface-container px-1.5 py-0.5 rounded font-bold';
        statusPill.innerText = 'VERIFIED';
      } else if (stepIdx === currentStep) {
        item.classList.add('bg-surface-container', 'text-on-surface');
        item.classList.remove('text-on-surface-variant');
        numBadge.className = 'step-num w-6 h-6 rounded-lg bg-primary-container text-on-primary flex items-center justify-center font-label-xs text-label-xs font-bold shrink-0 mt-0.5';
        numBadge.innerText = stepIdx;
        statusPill.className = 'status-pill font-label-xs text-label-xs text-secondary bg-secondary-fixed/50 px-1.5 py-0.5 rounded font-bold';
        statusPill.innerText = 'IN PROGRESS';
      } else {
        item.classList.remove('bg-surface-container', 'text-on-surface');
        item.classList.add('text-on-surface-variant');
        numBadge.className = 'step-num w-6 h-6 rounded-lg bg-surface-container-high text-on-surface-variant flex items-center justify-center font-label-xs text-label-xs font-bold shrink-0 mt-0.5';
        numBadge.innerText = stepIdx;
        statusPill.className = 'status-pill font-label-xs text-label-xs text-outline font-normal';
        statusPill.innerText = 'PENDING';
      }
    });
  }

  function nextStep(target) {
    if (target <= 5) {
      currentStep = target;
      updateWizardUI();
    }
  }

  function prevStep(target) {
    if (target >= 1) {
      currentStep = target;
      updateWizardUI();
    }
  }

  function jumpToStep(step) {
    currentStep = step;
    updateWizardUI();
  }

  function selectEntity(type) {
    selectedEntity = type;
    const soloCard = document.getElementById('entityCardSolo');
    const agencyCard = document.getElementById('entityCardAgency');
    const soloBadge = document.getElementById('soloSelectedBadge');
    const agencyBadge = document.getElementById('agencySelectedBadge');
    const agencyRccmFields = document.getElementById('agencyRccmFields');

    if (type === 'solo') {
      soloCard.classList.add('bg-surface-container', 'ring-2', 'ring-secondary');
      soloCard.classList.remove('bg-surface-container-low');
      soloBadge.classList.remove('hidden');

      agencyCard.classList.remove('bg-surface-container', 'ring-2', 'ring-secondary');
      agencyCard.classList.add('bg-surface-container-low');
      agencyBadge.classList.add('hidden');
      agencyRccmFields.classList.add('hidden');
    } else {
      agencyCard.classList.add('bg-surface-container', 'ring-2', 'ring-secondary');
      agencyCard.classList.remove('bg-surface-container-low');
      agencyBadge.classList.remove('hidden');

      soloCard.classList.remove('bg-surface-container', 'ring-2', 'ring-secondary');
      soloCard.classList.add('bg-surface-container-low');
      soloBadge.classList.add('hidden');
      agencyRccmFields.classList.remove('hidden');
    }
  }

  function claimProfile(name) {
    alert(`Catalog for "${name}" claimed! Pre-populating streaming metadata from Spotify & Boomplay CMR.`);
    nextStep(3);
  }

  function triggerPathBAudit() {
    alert('5,000 XAF fast-track audit order initiated. CamPay prompt will test in Step 5.');
    nextStep(3);
  }

  function copyToken() {
    const token = document.getElementById('handshakeTokenText').innerText;
    navigator.clipboard.writeText(token).then(() => {
      alert(`Token ${token} copied to clipboard! Paste in your profile bio.`);
    });
  }

  function runScraperVerification() {
    const btn = document.getElementById('pulseScraperBtn');
    const ytBadge = document.getElementById('ytSyncStatus');
    const tiktokBadge = document.getElementById('tiktokSyncStatus');
    
    btn.innerHTML = '<span>Scanning...</span><span class="material-symbols-outlined text-[16px] animate-spin">refresh</span>';

    setTimeout(() => {
      ytBadge.className = 'font-label-xs text-label-xs bg-tertiary-fixed text-on-tertiary-fixed px-2 py-0.5 rounded font-bold flex items-center gap-1';
      ytBadge.innerHTML = '<span class="material-symbols-outlined text-[12px]">check</span> TOKEN MATCHED';
      
      tiktokBadge.className = 'font-label-xs text-label-xs bg-tertiary-fixed text-on-tertiary-fixed px-2 py-0.5 rounded font-bold flex items-center gap-1';
      tiktokBadge.innerHTML = '<span class="material-symbols-outlined text-[12px]">check</span> TOKEN MATCHED';

      btn.innerHTML = '<span>Handshake Confirmed</span><span class="material-symbols-outlined text-[16px] text-on-tertiary-container">done_all</span>';
    }, 1200);
  }

  function verifyNIU() {
    const badge = document.getElementById('niuClearanceBadge');
    badge.innerText = 'VERIFYING DGI DATABASE...';
    badge.className = 'font-label-xs text-label-xs text-secondary font-bold';

    setTimeout(() => {
      badge.innerText = 'VALIDATED • FISCAL CODE ACTIVE';
      badge.className = 'font-label-xs text-label-xs text-on-tertiary-container font-bold';
    }, 800);
  }

  function selectCarrier(carrier) {
    activeCarrier = carrier;
    const mtnCard = document.getElementById('mtnOptionCard');
    const orangeCard = document.getElementById('orangeOptionCard');
    const mtnDot = document.getElementById('mtnRadioDot');
    const orangeDot = document.getElementById('orangeRadioDot');

    if (carrier === 'mtn') {
      mtnCard.classList.add('border-2', 'border-secondary', 'bg-surface-container');
      mtnCard.classList.remove('bg-surface-container-low');
      mtnDot.className = 'w-4 h-4 rounded-full bg-secondary flex items-center justify-center';
      mtnDot.children[0].classList.remove('hidden');

      orangeCard.classList.remove('border-2', 'border-secondary', 'bg-surface-container');
      orangeCard.classList.add('bg-surface-container-low');
      orangeDot.className = 'w-4 h-4 rounded-full bg-surface-container-highest flex items-center justify-center';
      orangeDot.children[0].classList.add('hidden');
    } else {
      orangeCard.classList.add('border-2', 'border-secondary', 'bg-surface-container');
      orangeCard.classList.remove('bg-surface-container-low');
      orangeDot.className = 'w-4 h-4 rounded-full bg-secondary flex items-center justify-center';
      orangeDot.children[0].classList.remove('hidden');

      mtnCard.classList.remove('border-2', 'border-secondary', 'bg-surface-container');
      mtnCard.classList.add('bg-surface-container-low');
      mtnDot.className = 'w-4 h-4 rounded-full bg-surface-container-highest flex items-center justify-center';
      mtnDot.children[0].classList.add('hidden');
    }
  }

  function triggerUSSDPing() {
    const consoleBox = document.getElementById('ussdLogContent');
    const btn = document.getElementById('sendPingBtn');
    
    btn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span><span>Pinging Handset...</span>';
    
    consoleBox.innerHTML = `
      <p class="text-tertiary-fixed">&gt; [0.00s] PING INITIATED to CamPay Node Douala...</p>
      <p class="text-secondary-fixed">&gt; [0.45s] USSD Session pushed to MSISDN +237 677 82 91 04</p>
    `;

    setTimeout(() => {
      consoleBox.innerHTML += `
        <p class="text-tertiary-fixed">&gt; [1.12s] Carrier ACK Received. Prompt: "Approve 10 XAF Test Escrow?"</p>
        <p class="text-on-tertiary-container font-bold">&gt; [2.40s] SUCCESS: User PIN accepted. Session Terminated 200 OK.</p>
      `;
      btn.innerHTML = '<span class="material-symbols-outlined text-[18px] text-tertiary-fixed">done_all</span><span>USSD Verified</span>';
      btn.classList.add('bg-on-tertiary-container');
    }, 1500);
  }

  function finalizeActivation() {
    document.getElementById('stepContainer5').classList.add('hidden');
    document.getElementById('activationSuccessCard').classList.remove('hidden');
  }

  function handleCreatorSearch(val) {
    const cards = document.getElementById('creatorResultsGrid').children;
    for (let card of cards) {
      if (card.innerText.toLowerCase().includes(val.toLowerCase())) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    }
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', () => {
    selectEntity('solo');
    updateWizardUI();
  });
</script></main></div></body></html>

