<script>
  // 1. CAROUSEL AUTO-SLIDING LOGIC
  let currentSlide = 0;
  const totalSlides = 3;
  let carouselInterval = null;

  function showSlide(index) {
    currentSlide = index;
    for (let i = 0; i < totalSlides; i++) {
      const slide = document.getElementById('predSlide' + i);
      const dot = document.getElementById('dot' + i);
      if (slide) {
        if (i === currentSlide) {
          slide.classList.remove('hidden');
          slide.classList.remove('absolute');
          slide.style.opacity = '1';
        } else {
          slide.classList.add('hidden');
          slide.classList.add('absolute');
          slide.style.opacity = '0';
        }
      }
      if (dot) {
        if (i === currentSlide) {
          dot.className = 'w-6 h-1 rounded-full bg-secondary transition-all';
        } else {
          dot.className = 'w-2 h-1 rounded-full bg-outline/50 transition-all';
        }
      }
    }
    const badge = document.getElementById('carouselTimerBadge');
    if (badge) {
      badge.innerText = `Slide ${currentSlide + 1} of ${totalSlides}`;
    }
  }

  function nextSlide() {
    currentSlide = (currentSlide + 1) % totalSlides;
    showSlide(currentSlide);
  }

  function prevSlide() {
    currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
    showSlide(currentSlide);
  }

  function startCarouselTimer() {
    if (carouselInterval) clearInterval(carouselInterval);
    carouselInterval = setInterval(nextSlide, 5000);
  }

  // 2. TICKER CONTINUOUS MICRO-SCROLLING (Vanilla Animation)
  function initTicker() {
    const track = document.getElementById('tickerTrack');
    if (track && track.children[0]) {
      const clone = track.children[0].cloneNode(true);
      track.appendChild(clone);
      let pos = 0;
      function animateTicker() {
        pos -= 0.65;
        if (pos <= -track.children[0].offsetWidth) {
          pos = 0;
        }
        track.style.transform = `translateX(${pos}px)`;
        requestAnimationFrame(animateTicker);
      }
      requestAnimationFrame(animateTicker);
    }
  }

  // 3. TOAST NOTIFICATION SYSTEM
  let toastTimer = null;
  function showToast(title, message) {
    const toast = document.getElementById('toastNotification');
    const toastTitle = document.getElementById('toastTitle');
    const toastMessage = document.getElementById('toastMessage');
    if (!toast) return;

    if (toastTitle) toastTitle.innerText = title;
    if (toastMessage) toastMessage.innerText = message;

    toast.classList.remove('translate-y-3', 'opacity-0', 'pointer-events-none');
    toast.classList.add('translate-y-0', 'opacity-100');

    if (toastTimer) clearTimeout(toastTimer);
    toastTimer = setTimeout(dismissToast, 4500);
  }

  function dismissToast() {
    const toast = document.getElementById('toastNotification');
    if (toast) {
      toast.classList.add('translate-y-3', 'opacity-0', 'pointer-events-none');
      toast.classList.remove('translate-y-0', 'opacity-100');
    }
  }

  // 4. TRANSACTION MODAL HANDLERS
  function castVote(question, choice, price) {
    const modal = document.getElementById('momoModal');
    const modalTargetName = document.getElementById('modalTargetName');
    const modalTargetPrice = document.getElementById('modalTargetPrice');
    const modalActionTitle = document.getElementById('modalActionTitle');

    if (modalTargetName) modalTargetName.innerText = `${question} (${choice})`;
    if (modalTargetPrice) modalTargetPrice.innerText = `${price} XAF / share`;
    if (modalActionTitle) modalActionTitle.innerText = `Predict: ${choice} Vote`;

    if (modal) modal.classList.remove('hidden');
  }

  function investRace(raceName, minEntry) {
    const modal = document.getElementById('momoModal');
    const modalTargetName = document.getElementById('modalTargetName');
    const modalTargetPrice = document.getElementById('modalTargetPrice');
    const modalActionTitle = document.getElementById('modalActionTitle');

    if (modalTargetName) modalTargetName.innerText = raceName;
    if (modalTargetPrice) modalTargetPrice.innerText = `Min: ${minEntry.toLocaleString()} FCFA`;
    if (modalActionTitle) modalActionTitle.innerText = 'Invest in Creator Syndicate';

    if (modal) modal.classList.remove('hidden');
  }

  function triggerDepositModal() {
    const modal = document.getElementById('momoModal');
    const modalTargetName = document.getElementById('modalTargetName');
    const modalTargetPrice = document.getElementById('modalTargetPrice');
    const modalActionTitle = document.getElementById('modalActionTitle');

    if (modalTargetName) modalTargetName.innerText = 'Main Crippo Wallet Balance';
    if (modalTargetPrice) modalTargetPrice.innerText = 'Direct Instant Deposit';
    if (modalActionTitle) modalActionTitle.innerText = 'MoMo / CamPay Cash-In';

    if (modal) modal.classList.remove('hidden');
  }

  function closeDepositModal() {
    const modal = document.getElementById('momoModal');
    if (modal) modal.classList.add('hidden');
  }

  function closeModalOnBackdrop(e) {
    if (e.target.id === 'momoModal') {
      closeDepositModal();
    }
  }

  function setAmount(val) {
    showToast('Amount Selected', `${val.toLocaleString()} FCFA ready for USSD prompt`);
  }

  function executeTransaction() {
    closeDepositModal();
    showToast('USSD Prompt Sent! 📲', 'Check phone for MTN MoMo or Orange Money PIN prompt (FCFA)');
  }

  function showStockDetail(symbol) {
    showToast(`Loading ${symbol} Terminal`, 'Fetching audited streaming royalties and token ledger');
  }

  // Initialize Lifecycle
  document.addEventListener('DOMContentLoaded', () => {
    showSlide(0);
    startCarouselTimer();
    initTicker();
    // Welcome dividend notification toast
    setTimeout(() => {
      showToast('Dividend Payout Received', '+3,420 FCFA credited from KO-C Q2 royalties');
